# vibecommerce_test_code — пример .env
#
# При форке: скопируй в `.env` и заполни своими значениями.
# `.env` НЕ коммитится (см. .gitignore). Боевые токены клиентов — в `_private/secrets/`.

# === Marketplace API (опционально, для VIP-методик и mpstats-* skills) ===
# MPStats API key — https://mpstats.io
MPSTATS_API_KEY=

# WB Seller API — https://seller.wildberries.ru → Профиль → Доступ к API
WB_API_TOKEN=

# Ozon Seller API — https://seller.ozon.ru → API → Сертификаты
OZON_CLIENT_ID=
OZON_API_KEY=

# Яндекс.Маркет Partner API
# YANDEX_MARKET_OAUTH_TOKEN=
# YANDEX_MARKET_CLIENT_ID=

# === SEO API (VIP только) ===
# AHREFS_API_KEY=
# SEMRUSH_API_KEY=
# DATAFORSEO_LOGIN=
# DATAFORSEO_PASSWORD=

# === DaData (counterparty-check, VIP только) ===
# DADATA_API_KEY=
# DADATA_SECRET_KEY=
